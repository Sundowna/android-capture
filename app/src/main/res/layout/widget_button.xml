<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1 widget: one capture type, one tap starts talking. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wb_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_amber" android:orientation="vertical" android:gravity="center"
    android:padding="6dp" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/wb_icon" android:layout_width="26dp" android:layout_height="26dp"
        android:src="@drawable/t_idea" android:importantForAccessibility="no" />
    <TextView android:id="@+id/wb_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#FF2A2118" android:textSize="12sp" android:textStyle="bold"
        android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_button_default" />
</LinearLayout>
